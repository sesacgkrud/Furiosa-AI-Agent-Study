# GitHub 파일 용량 제한(100MB) - 코드와 문서만 올리고 데이터 / 모델 파일은 올리지 않는다
# 아래 폴더들은 각자 내려받거나 코드를 실행하면 다시 만들어진다

# 데이터셋
# Kaggle Santander : https://www.kaggle.com/competitions/santander-customer-transaction-prediction/data
_data/kaggle_santander/
# Kaggle Jena Climate : https://www.kaggle.com/datasets/stytch16/jena-climate-2009-2016
_data/kaggle_jena/
# 이미지 데이터 (brain / cat_dog)
_data/image/
# ImageDataGenerator 결과를 저장한 npy (keras45 / keras46) - cat_dog x_train 은 약 960MB
_data/*_npy/
# 그 외 데이터 폴더의 대용량 산출물
_data/temp/
_data/**/submit/

# 저장한 모델 / 가중치 파일
_save/

# Python
__pycache__/
*.pyc
